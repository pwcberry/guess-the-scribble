# Port the Fastify game server (server/src/index.ts) listens on.
PORT=3000

# PostgreSQL credentials. These are read by both the pg driver (PGUSER /
# PGPASSWORD are libpq standard env vars) and by docker-compose to initialise
# the container. Keep this file as .env (gitignored) — never commit credentials.
PGUSER=scribbler
PGPASSWORD=change-me

# PostgreSQL connection URL — host, port, and database only; no credentials.
# The pg driver merges PGUSER/PGPASSWORD above automatically.
# Default dev database:
DATABASE_URL=postgresql://localhost:5432/guess_the_scribble

# Test database (overrides the vitest.config.ts default when running npm test):
# DATABASE_URL=postgresql://localhost:5432/gts_test
