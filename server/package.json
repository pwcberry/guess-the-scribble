{
  "name": "@gts/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=../.env src/db/migrate.ts --reset"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.3.0",
    "@gts/shared": "*",
    "fastify": "^5.10.0",
    "kysely": "^0.29.4",
    "nanoid": "^3.3.16",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.14",
    "@types/ws": "^8.18.1"
  }
}
